# EcoLiz Frontend Configuration

# ===== WORDPRESS / WOOCOMMERCE =====
# Production WordPress URL (used for redirects to WooCommerce my-account, cart, etc.)
# For development, this should point to your local WordPress instance
VITE_WORDPRESS_URL=http://localhost:8000/index.php
VITE_CF7_CONTACT_FORM_ID=6567

# WooCommerce Store API endpoint (public catalog API)
# The frontend will fetch products from /wp-json/wc/store/products
# Proxied through Nginx in production: /wp-api -> /wp-json
VITE_WOO_API_URL=/wp-api/wc/store

# EcoLiz Custom API endpoint (orders, equipment, health check)
# Proxied through Nginx in production: /wp-api -> /wp-json
VITE_ECOLIZ_API_URL=/wp-api/ecoliz/v1

# ===== PRODUCTION VALUES =====
# For production deployment, replace with:
# VITE_WORDPRESS_URL=https://yourdomain.com/index.php
# VITE_WOO_API_URL=https://yourdomain.com/wp-json/wc/store
# VITE_ECOLIZ_API_URL=https://yourdomain.com/wp-json/ecoliz/v1
